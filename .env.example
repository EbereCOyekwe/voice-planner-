# Copy to .env for local runs. Never commit .env.
# The full Base64 key copied from the Inworld Portal (key and secret combined).
INWORLD_API_KEY=

# Optional but recommended once deployed: anyone opening the app must enter this.
APP_PASSCODE=

# Optional overrides (defaults shown).
# INWORLD_MODEL=openai/gpt-4o-mini
# INWORLD_VOICE=Clive
# INWORLD_TTS_MODEL=inworld-tts-2
